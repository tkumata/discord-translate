{
  "manifest_version": 3,
  "name": "Discord Local Translator",
  "version": "0.1.0",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*"
      ],
      "js": [
        "request-client.js",
        "received-messages.js",
        "draft-composer.js",
        "content-script.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8080/*",
    "http://127.0.0.1:8766/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bridge.html"
      ],
      "matches": [
        "https://discord.com/*"
      ]
    }
  ]
}
